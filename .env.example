NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://rejectradar:rejectradar@localhost:5432/rejectradar
TEST_DATABASE_SERVER_URL=postgres://rejectradar:rejectradar@localhost:5432
# Generate with: npm run secret   (the API refuses to start with this placeholder)
JWT_SECRET=replace-with-output-of-npm-run-secret
APP_ORIGIN=http://localhost:4200
# How account emails are sent. Locally "smtp" delivers to Mailpit (docker compose, UI at http://localhost:8025).
# The API refuses to start in production unless this is "resend" with a real RESEND_API_KEY.
MAIL_TRANSPORT=smtp
# Used by the smtp transport. Default: smtp://127.0.0.1:1025
MAIL_SMTP_URL=smtp://127.0.0.1:1025
# Required when MAIL_TRANSPORT=resend. Create one in the Resend dashboard (sending access only).
RESEND_API_KEY=
# The From header of every email: "Name <address>" or a bare address. The domain must be verified in Resend.
MAIL_FROM="RejectRadar <alerts@rejectradar.umarnazaket.com>"
# apps/ingest reads APP_ORIGIN, MAIL_TRANSPORT, MAIL_SMTP_URL, RESEND_API_KEY and MAIL_FROM too, but only for alerts:run and digest:send
# (alerts:run --no-email needs none of them). In GitHub Actions APP_ORIGIN and MAIL_FROM are repository variables, RESEND_API_KEY a secret.
# Proxies in front of the API whose X-Forwarded-For is trusted (0-5), so the per-IP rate limits see the client.
# 0 locally; the owner sets it for staging and production from what the logs show.
TRUST_PROXY_HOPS=0

# Paddle billing (P7). Every variable is required in every environment and checked at start, so a wrong deploy fails fast.
# sandbox or production. Staging runs NODE_ENV=production with PADDLE_ENV=sandbox.
PADDLE_ENV=sandbox
# Server-side API key (Paddle > Developer tools > Authentication). pdl_sdbx_apikey_... for sandbox, pdl_live_apikey_... for production.
PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
# Client-side token for Paddle.js, same page. test_... for sandbox, live_... for production. Safe to expose to the browser.
PADDLE_CLIENT_TOKEN=test_replace_me
# Endpoint secret of the notification destination pointing at POST /webhooks/paddle (Developer tools > Notifications). pdl_ntfset_...
# Locally any value of 32+ characters that is not a placeholder works: "npm run secret" prints one.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
# The four recurring prices (Catalog > Products), matching spec section 10.1: Pro $39/month and $390/year, Business $149/month and $1,490/year.
PADDLE_PRICE_PRO_MONTHLY=pri_replace_me
PADDLE_PRICE_PRO_YEARLY=pri_replace_me
PADDLE_PRICE_BUSINESS_MONTHLY=pri_replace_me
PADDLE_PRICE_BUSINESS_YEARLY=pri_replace_me

# apps/ingest only. FDA credentials come from FDA's OII Unified Logon application (spec §6.1).
FDA_API_USER=
FDA_API_KEY=
# Required by every ingest command that touches the network. Goes into the User-Agent of every request
# ("RejectRadar data sync (<address>)") so source operators can reach us (spec §6.3).
INGEST_CONTACT_EMAIL=
# Where a sync saves a page it could not parse, for debugging. Default: tmp/ingest-failures
# INGEST_FAILURE_DIR=tmp/ingest-failures

# apps/ingest only, for summaries:draft and summaries:translate (no other command reads them).
# A Gemini API key from Google AI Studio, and the model, e.g. gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=
