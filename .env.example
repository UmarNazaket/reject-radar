NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://rejectradar:rejectradar@localhost:5432/rejectradar
TEST_DATABASE_SERVER_URL=postgres://rejectradar:rejectradar@localhost:5432
# Generate with: npm run secret   (the API refuses to start with this placeholder)
JWT_SECRET=replace-with-output-of-npm-run-secret
APP_ORIGIN=http://localhost:4200

# apps/ingest only. FDA credentials come from FDA's OII Unified Logon application (spec §6.1).
FDA_API_USER=
FDA_API_KEY=
# Contact address sent in the User-Agent of every download.
INGEST_CONTACT_EMAIL=
