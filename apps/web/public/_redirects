# Cloudflare Pages: routes rendered in the browser get the empty app shell, index.csr.html, named without .html
# because Pages redirects a .html path to its extensionless form, which would change the address. The pre-rendered
# public pages (app.routes.server.ts) are files of their own, and any other path gets the root page. A rule here
# applies even where a file exists, so the public pages must not be listed (app.routes.server.spec.ts checks both).
/topics /index.csr 200
/topics/* /index.csr 200
/notices /index.csr 200
/notices/* /index.csr 200
/firms /index.csr 200
/firms/* /index.csr 200
/mrl /index.csr 200
/mrl/* /index.csr 200
/watchlist /index.csr 200
/watchlist/* /index.csr 200
/alerts /index.csr 200
/alerts/* /index.csr 200
/bulk /index.csr 200
/bulk/* /index.csr 200
/settings /index.csr 200
/settings/* /index.csr 200
/admin /index.csr 200
/admin/* /index.csr 200
/import-alerts /index.csr 200
/import-alerts/* /index.csr 200
/app /index.csr 200
/app/* /index.csr 200
/login /index.csr 200
/login/* /index.csr 200
/signup /index.csr 200
/signup/* /index.csr 200
/forgot /index.csr 200
/forgot/* /index.csr 200
/verify /index.csr 200
